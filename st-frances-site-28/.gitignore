# Dependencies (only relevant if you ever add npm packages,
# e.g. Firebase Cloud Functions later) -- never commit this folder,
# it can be huge and is always regenerated from package.json.
node_modules/

# Firebase CLI local cache/logs (created when you run firebase deploy,
# firebase emulators:start, etc.)
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log

# Netlify CLI local cache (only appears if you use netlify dev /
# netlify link from the command line -- harmless to ignore either way)
.netlify/

# Environment/secret files (if you ever add API keys outside of
# firebase-config.js, keep them out of git entirely)
.env
.env.local

# OS-generated junk files
.DS_Store
Thumbs.db
desktop.ini

# Editor folders (personal settings, not part of the site itself)
.vscode/
.idea/

# Common build output folders, in case you ever add a bundler
dist/
build/